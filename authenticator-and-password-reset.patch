+
+export default function Users() {
+  const gate = useAuthGate()
+  const me = currentUser()
+  const [rows, reload] = useLive(() => (isAdmin() ? get('/api/users') : Promise.resolve([])), 0)
+  const [msg, setMsg] = useState(null)
