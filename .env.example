# Copy to .env and edit. run_server.py loads .env automatically.
# Database: SQLite works out of the box; PostgreSQL is recommended for real use.
DATABASE_URL=sqlite:///./edr.db
# DATABASE_URL=postgresql+psycopg2://edr:edr_password@localhost:5432/edr

# REQUIRED to change outside the lab. Sessions are invalidated if SECRET_KEY changes (or is unset: a random key is used per start).
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Also encrypts the stored authenticator-app secrets: set it once and keep it, or users must re-link their authenticator.
ENROLLMENT_TOKEN=lab-enrollment-token
BACKUP_DIR=./backups
BACKUP_KEY=change-me-backup-passphrase

# Active Directory: mock = lab/lab_directory.json (domain lab.local); ldap = real domain controller over LDAPS
AD_MODE=mock
AD_SERVER=dc01.lab.local
AD_BASE_DN=DC=lab,DC=local
AD_BIND_DN=CN=svc_edr,CN=Users,DC=lab,DC=local
AD_BIND_PASSWORD=
AD_USE_SSL=true

HOST=127.0.0.1
PORT=8000

# Name shown in the authenticator app next to the username
TOTP_ISSUER=AD-EDR
