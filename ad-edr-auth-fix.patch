diff --git a/dashboard/src/pages/Account.jsx b/dashboard/src/pages/Account.jsx
new file mode 100644
index 0000000..f2d2ee3
--- /dev/null
+++ b/dashboard/src/pages/Account.jsx
@@ -0,0 +1,113 @@
+import { useEffect, useState } from 'react'
+import { errMsg, get, post, setSession, setUser } from '../api/client.js'
+
+const tooShort = (p) => p.length < 8
+
+export default function Account() {
+  const [me, setMe] = useState(null)
+  const reload = () => get('/api/auth/me').then((u) => { setMe(u); setUser(u) }).catch(() => {})
+  useEffect(() => { reload() }, [])
+  return (
+    <>
+      <h1 className="page-title">My account</h1>
+      <p className="page-subtitle">{me ? `${me.username} · ${me.role}` : '…'}</p>
+      {me?.must_change_password && (
+        <div className="flash err">You must choose a new password before you can use the rest of the system.</div>
+      )}
+      <div className="grid2">
+        <PasswordPanel forced={!!me?.must_change_password} />
+        {!me?.must_change_password && <AuthenticatorPanel me={me} onChange={reload} />}
+      </div>
+    </>
+  )
+}
+
+function PasswordPanel({ forced }) {
+  const [cur, setCur] = useState('')
+  const [pw, setPw] = useState('')
+  const [pw2, setPw2] = useState('')
+  const [msg, setMsg] = useState(null)
+  async function submit(e) {
+    e.preventDefault()
+    if (tooShort(pw)) return setMsg({ text: 'New password must be at least 8 characters' })
+    if (pw !== pw2) return setMsg({ text: 'The two new passwords do not match' })
+    try {
+      setSession(await post('/api/auth/password/change', { current_password: cur, new_password: pw }))  // keeps this browser signed in
+      setCur(''); setPw(''); setPw2('')
+      if (forced) return window.location.assign('/account')  // reload so the menu unlocks
+      setMsg({ ok: true, text: 'Password changed. Other devices have been signed out.' })
+    } catch (x) { setMsg({ text: errMsg(x) }) }
+  }
+  return (
+    <form className="panel" onSubmit={submit}>
+      <h3>Change password</h3>
+      <div className="field"><label>Current password</label><input type="password" autoComplete="current-password" value={cur} onChange={(e) => setCur(e.target.value)} /></div>
+      <div className="field"><label>New password</label><input type="password" autoComplete="new-password" value={pw} onChange={(e) => setPw(e.target.value)} /></div>
+      <div className="field"><label>Repeat new password</label><input type="password" autoComplete="new-password" value={pw2} onChange={(e) => setPw2(e.target.value)} /></div>
+      <button className="btn" type="submit">Change password</button>
+      {msg && <div className={`flash ${msg.ok ? 'ok' : 'err'}`} style={{ marginTop: 10 }}>{msg.text}</div>}
+    </form>
+  )
+}
+
+function AuthenticatorPanel({ me, onChange }) {
+  const [setup, setSetup] = useState(null)   // { qr_png_base64, manual_key, setup_token }
+  const [code, setCode] = useState('')
+  const [curPw, setCurPw] = useState('')
+  const [curCode, setCurCode] = useState('')
+  const [msg, setMsg] = useState(null)
+  const enrolled = me?.authenticator_enrolled
+
+  async function start(e) {
+    e?.preventDefault()
+    try {
+      setSetup(await post('/api/auth/totp/setup', enrolled ? { current_password: curPw, current_code: curCode } : {}))
+      setMsg(null)
+    } catch (x) { setMsg({ text: errMsg(x) }) }
+  }
+  async function confirm(e) {
+    e.preventDefault()
+    try {
+      await post('/api/auth/totp/confirm', { setup_token: setup.setup_token, code })
+      setSetup(null); setCode(''); setCurPw(''); setCurCode('')
+      setMsg({ ok: true, text: 'Authenticator linked. It will now approve QR verifications.' })
+      onChange()
+    } catch (x) { setMsg({ text: errMsg(x) }) }
+  }
+
+  return (
+    <div className="panel">
+      <h3>Authenticator app (biometric verification)</h3>
+      <p className="muted" style={{ marginTop: 0 }}>
+        Status: <b style={{ color: enrolled ? 'var(--accent)' : 'var(--critical)' }}>{enrolled ? 'linked' : me?.biometric_enrolled ? 'demo reference only - link a real app' : 'not linked'}</b>
+      </p>
+      {!setup && (
+        <form onSubmit={start}>
+          {enrolled && (<>
+            <p className="muted">To replace your authenticator, confirm your password and a current code from the old one.</p>
+            <div className="field"><label>Current password</label><input type="password" value={curPw} onChange={(e) => setCurPw(e.target.value)} /></div>
+            <div className="field"><label>Current 6-digit code</label><input inputMode="numeric" value={curCode} onChange={(e) => setCurCode(e.target.value)} /></div>
+          </>)}
+          <button className="btn" type="submit">{enrolled ? 'Replace authenticator…' : 'Set up authenticator…'}</button>
+        </form>
+      )}
+      {setup && (
+        <form onSubmit={confirm}>
+          <ol className="muted" style={{ paddingLeft: 18, lineHeight: 1.6 }}>
+            <li><b>Microsoft Authenticator</b>: tap <b>+</b> → <b>Other account (Google, Facebook, etc.)</b> → scan the QR. Do <u>not</u> pick "Work or school account".</li>
+            <li><b>Google Authenticator, Authy, 1Password, Aegis</b> or any other TOTP app also works.</li>
+            <li>Turn on the app's fingerprint / face lock so the code needs your biometric to open.</li>
+          </ol>
+          <img alt="Authenticator QR" className="qr" src={`data:image/png;base64,${setup.qr_png_base64}`} />
+          <div className="mono muted" style={{ fontSize: 12, margin: '8px 0' }}>Can't scan? Enter this key manually: <b style={{ color: 'var(--text)' }}>{setup.manual_key}</b> (time-based, 6 digits)</div>
+          <div className="field"><label>Enter the 6-digit code the app now shows</label><input inputMode="numeric" autoComplete="one-time-code" autoFocus value={code} onChange={(e) => setCode(e.target.value)} /></div>
+          <div style={{ display: 'flex', gap: 8 }}>
+            <button className="btn" type="submit">Verify and link</button>
+            <button className="btn ghost" type="button" onClick={() => { setSetup(null); setCode('') }}>Cancel</button>
+          </div>
+        </form>
+      )}
+      {msg && <div className={`flash ${msg.ok ? 'ok' : 'err'}`} style={{ marginTop: 10 }}>{msg.text}</div>}
+    </div>
+  )
+}
