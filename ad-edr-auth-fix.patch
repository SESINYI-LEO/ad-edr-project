@@ -0,0 +1,154 @@
+"""Authenticator-app enrolment (TOTP), password change/reset and admin user management."""
+import pyotp
+import pytest
+
+from app.security import TOTP_PERIOD
+from tests.conftest import login, verified_tx
+
+
+class Clock:
+    """Move time forward in 30 s steps so each TOTP code is a fresh one (a code can only be used once)."""
+    def __init__(self, monkeypatch):
+        import time
+        self.real, self.offset, self.mp = time.time, 0, monkeypatch
+        monkeypatch.setattr("app.security.time.time", lambda: self.real() + self.offset)
+
+    def tick(self, steps=1):
+        self.offset += steps * TOTP_PERIOD
+
+    def code(self, secret):
+        return pyotp.TOTP(secret).at(self.real() + self.offset)
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    return Clock(monkeypatch)
+
+
+def _hdr(client, user, pw):
+    return login(client, user, pw)
+
+
+def _new_user(client, admin, name, role="analyst", pw="Initial#Pass1"):
+    r = client.post("/api/users", json={"username": name, "password": pw, "role": role, "email": f"{name}@edr.local"}, headers=admin)
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+def _enroll(client, headers, clock):
+    s = client.post("/api/auth/totp/setup", json={}, headers=headers).json()
+    assert s["otpauth_uri"].startswith("otpauth://totp/") and "issuer=Sentry" in s["otpauth_uri"] and s["qr_png_base64"]
+    secret = s["otpauth_uri"].split("secret=")[1].split("&")[0]
+    code = clock.code(secret)
+    r = client.post("/api/auth/totp/confirm", json={"setup_token": s["setup_token"], "code": code}, headers=headers)
+    assert r.status_code == 200 and r.json()["authenticator_enrolled"] is True, r.text
+    clock.tick()
+    return secret
+
+
+def _tx_code(client, headers, secret, purpose, clock, code=None):
+    tx = client.post("/api/auth/transactions", json={"purpose": purpose}, headers=headers).json()
+    v = client.post(f"/api/auth/transactions/{tx['id']}/verify", json={"credential": code or clock.code(secret)}).json()
+    clock.tick()
+    return tx["id"], v["status"]
+
+
+# ---------- new account must set its own password, then enrol ----------
+def test_new_user_must_change_password_and_old_sessions_die(client, admin):
+    _new_user(client, admin, "lerato")
+    h = _hdr(client, "lerato", "Initial#Pass1")
+    assert client.get("/api/auth/me", headers=h).json()["must_change_password"] is True
+    assert client.get("/api/alerts", headers=h).status_code == 403  # blocked until password is changed
+    assert client.post("/api/auth/password/change", json={"current_password": "wrong", "new_password": "Brand#New2pass"}, headers=h).status_code == 400
+    assert client.post("/api/auth/password/change", json={"current_password": "Initial#Pass1", "new_password": "Initial#Pass1"}, headers=h).status_code == 400
+    r = client.post("/api/auth/password/change", json={"current_password": "Initial#Pass1", "new_password": "Brand#New2pass"}, headers=h)
+    assert r.status_code == 200
+    fresh = {"Authorization": f"Bearer {r.json()['access_token']}"}
+    assert client.get("/api/alerts", headers=fresh).status_code == 200
+    assert client.get("/api/auth/me", headers=h).status_code == 401  # token from before the change is revoked
+    assert client.post("/api/auth/login", data={"username": "lerato", "password": "Initial#Pass1"}).status_code == 401
+    assert client.post("/api/auth/login", data={"username": "lerato", "password": "Brand#New2pass"}).status_code == 200
+
+
+# ---------- authenticator enrolment + use ----------
+def test_enrol_authenticator_and_use_it_for_a_gated_action(client, admin, clock):
+    _new_user(client, admin, "thabo")
+    h = _hdr(client, "thabo", "Initial#Pass1")
+    h = {"Authorization": "Bearer " + client.post("/api/auth/password/change", json={"current_password": "Initial#Pass1", "new_password": "Thabo#Pass99"}, headers=h).json()["access_token"]}
+    # nothing enrolled yet -> a gated action cannot even start
+    assert client.post("/api/auth/transactions", json={"purpose": "terminal"}, headers=h).status_code == 409
+    # a wrong first code does not enrol
+    s = client.post("/api/auth/totp/setup", json={}, headers=h).json()
+    assert client.post("/api/auth/totp/confirm", json={"setup_token": s["setup_token"], "code": "000000"}, headers=h).status_code == 400
+    assert client.get("/api/auth/me", headers=h).json()["authenticator_enrolled"] is False
+    # someone else's setup token is useless
+    assert client.post("/api/auth/totp/confirm", json={"setup_token": s["setup_token"], "code": "123456"}, headers=admin).status_code == 400
+
+    secret = _enroll(client, h, clock)
+    tx, status = _tx_code(client, h, secret, "terminal", clock)
+    assert status == "verified"
+    # replay: a code that was already used is refused
+    code = clock.code(secret)
+    t1 = client.post("/api/auth/transactions", json={"purpose": "terminal"}, headers=h).json()
+    assert client.post(f"/api/auth/transactions/{t1['id']}/verify", json={"credential": code}).json()["status"] == "verified"
+    t2 = client.post("/api/auth/transactions", json={"purpose": "terminal"}, headers=h).json()
+    assert client.post(f"/api/auth/transactions/{t2['id']}/verify", json={"credential": code}).json()["status"] == "pending"
+    # the old typed "biometric" reference no longer works once a real authenticator exists
+    t3 = client.post("/api/auth/transactions", json={"purpose": "terminal"}, headers=h).json()
+    assert client.post(f"/api/auth/transactions/{t3['id']}/verify", json={"credential": "demo-fingerprint"}).json()["status"] == "pending"
+
+
+def test_replacing_authenticator_needs_password_and_current_code(client, admin, clock):
+    _new_user(client, admin, "naledi2")
+    h = _hdr(client, "naledi2", "Initial#Pass1")
+    h = {"Authorization": "Bearer " + client.post("/api/auth/password/change", json={"current_password": "Initial#Pass1", "new_password": "Naledi#Pass99"}, headers=h).json()["access_token"]}
+    secret = _enroll(client, h, clock)
+    assert client.post("/api/auth/totp/setup", json={}, headers=h).status_code == 403
+    assert client.post("/api/auth/totp/setup", json={"current_password": "Naledi#Pass99", "current_code": "000000"}, headers=h).status_code == 403
+    ok = client.post("/api/auth/totp/setup", json={"current_password": "Naledi#Pass99", "current_code": clock.code(secret)}, headers=h)
+    assert ok.status_code == 200
+
+
+# ---------- forgot password with the authenticator ----------
+def test_forgot_password_via_authenticator_and_throttle(client, admin, clock):
+    _new_user(client, admin, "kagiso")
+    h = _hdr(client, "kagiso", "Initial#Pass1")
+    h = {"Authorization": "Bearer " + client.post("/api/auth/password/change", json={"current_password": "Initial#Pass1", "new_password": "Kagiso#Pass99"}, headers=h).json()["access_token"]}
+    secret = _enroll(client, h, clock)
+    body = lambda c: {"username": "kagiso", "code": c, "new_password": "Reset#Pass123"}
+    assert client.post("/api/auth/password/reset", json=body(clock.code(secret))).json() == {"reset": True}
+    assert client.post("/api/auth/login", data={"username": "kagiso", "password": "Reset#Pass123"}).status_code == 200
+    assert client.get("/api/auth/me", headers=h).status_code == 401  # the old session ended
+    # unknown user and wrong code look identical, and guessing is throttled
+    bad = [client.post("/api/auth/password/reset", json={"username": "nobody", "code": "111111", "new_password": "Whatever#123"}) for _ in range(5)]
+    assert {r.status_code for r in bad} == {400}
+    assert client.post("/api/auth/password/reset", json={"username": "nobody", "code": "111111", "new_password": "Whatever#123"}).status_code == 429
+
+
+# ---------- admin controls ----------
+def test_admin_reset_password_and_authenticator_need_verification(client, admin):
+    _new_user(client, admin, "boitumelo")
+    uid = next(u["id"] for u in client.get("/api/users", headers=admin).json() if u["username"] == "boitumelo")
+    assert client.post(f"/api/users/{uid}/reset-password", json={}, headers=admin).status_code == 403  # no QR + code yet
+    tx, _ = verified_tx(client, admin, "user_admin")
+    r = client.post(f"/api/users/{uid}/reset-password", json={}, headers={**admin, "X-Auth-Transaction": tx})
+    assert r.status_code == 200
+    temp = r.json()["temporary_password"]
+    assert len(temp) >= 12
+    assert client.post(f"/api/users/{uid}/reset-password", json={}, headers={**admin, "X-Auth-Transaction": tx}).status_code == 403  # single use
+    assert client.get("/api/auth/me", headers=login(client, "boitumelo", temp)).json()["must_change_password"] is True
+    tx2, _ = verified_tx(client, admin, "user_admin")
+    assert client.post(f"/api/users/{uid}/reset-authenticator", headers={**admin, "X-Auth-Transaction": tx2}).json()["authenticator_enrolled"] is False
+    actions = [e["action"] for e in client.get("/api/audit", headers=admin).json()]
+    assert "password_reset_by_admin" in actions and "authenticator_reset_by_admin" in actions
+
+
+def test_user_edit_guards(client, admin, analyst):
+    me = next(u["id"] for u in client.get("/api/users", headers=admin).json() if u["username"] == "admin")
+    assert client.patch(f"/api/users/{me}", json={"role": "analyst"}, headers=admin).status_code == 409  # not yourself
+    assert client.patch(f"/api/users/{me}", json={"is_active": False}, headers=admin).status_code == 409
+    assert client.patch(f"/api/users/{me}", json={}, headers=admin).status_code == 400
+    other = next(u["id"] for u in client.get("/api/users", headers=admin).json() if u["username"] == "analyst")
+    assert client.patch(f"/api/users/{other}", json={"email": "new@edr.local"}, headers=admin).json()["email"] == "new@edr.local"  # email edit: no QR needed
+    assert client.patch(f"/api/users/{other}", json={"is_active": False}, headers=admin).status_code == 403  # privilege change: needs QR
+    assert client.patch(f"/api/users/{other}", json={"email": "x@edr.local"}, headers=analyst).status_code == 403  # analysts cannot edit users
