+import { useState } from 'react'
+import { errMsg, get, isAdmin, patch, post } from '../api/client.js'
+import { useLive } from '../api/hooks.js'
+import Badge from '../components/Badge.jsx'
+import { useAuthGate } from '../components/AuthGate.jsx'
+
+export default function Users() {
+  const gate = useAuthGate()
+  const [rows, reload] = useLive(() => (isAdmin() ? get('/api/users') : Promise.resolve([])), 0)
+  const [msg, setMsg] = useState(null)
+  const [temp, setTemp] = useState(null)       // { username, temporary_password } - shown once
+  const [edit, setEdit] = useState(null)       // { id, email, role }
+  const [nu, setNu] = useState({ username: '', password: '', role: 'analyst', email: '' })
+
+  if (!isAdmin()) return <><h1 className="page-title">Users</h1><p className="muted">Administrator access required.</p></>
+
+  const run = async (fn, ok) => {
+    try { const r = await fn(); setMsg({ ok: true, text: typeof ok === 'function' ? ok(r) : ok }); reload(); return r }
+    catch (e) { if (e.message !== 'cancelled') setMsg({ text: errMsg(e) }) }
+  }
+  const saveEdit = (u) => run(async () => {
+    const body = { email: edit.email }
+    if (edit.role !== u.role) body.role = edit.role
+    const tx = body.role ? await gate('user_admin') : undefined   // role changes need QR + authenticator
+    const r = await patch(`/api/users/${u.id}`, body, tx)
+    setEdit(null); return r
+  }, 'User updated')
+  const toggle = (u) => run(async () => patch(`/api/users/${u.id}`, { is_active: !u.is_active }, await gate('user_admin')), u.is_active ? 'User deactivated and signed out' : 'User reactivated')
+  const resetPw = (u) => window.confirm(`Reset the password for ${u.username}? They will be signed out and must choose a new password at next sign-in.`) &&
+    run(async () => { const r = await post(`/api/users/${u.id}/reset-password`, {}, await gate('user_admin')); setTemp(r); return r }, 'Password reset')
+  const resetMfa = (u) => window.confirm(`Remove ${u.username}'s authenticator? They will link a new one from My account.`) &&
+    run(async () => post(`/api/users/${u.id}/reset-authenticator`, {}, await gate('user_admin')), 'Authenticator removed')
+  const create = (e) => { e.preventDefault(); run(async () => { const r = await post('/api/users', nu); setNu({ username: '', password: '', role: 'analyst', email: '' }); return r }, 'User created - they must change this password at first sign-in') }
+
+  return (
+    <>
+      <h1 className="page-title">Users</h1>
+      <p className="page-subtitle">Manage console accounts. Role changes, deactivation and resets need QR + authenticator verification and are audited.</p>
+      {msg && <div className={`flash ${msg.ok ? 'ok' : 'err'}`}>{msg.text}</div>}
+      {temp && (
+        <div className="panel">
+          <h3>Temporary password for {temp.username}</h3>
+          <div className="mono" style={{ fontSize: 15, userSelect: 'all' }}>{temp.temporary_password}</div>
+          <p className="muted">Shown once. Give it to the user in person or over a trusted channel; they must change it at next sign-in.</p>
+          <button className="btn ghost sm" onClick={() => setTemp(null)}>Done</button>
+        </div>
+      )}
+      <div className="data-panel"><table>
+        <thead><tr><th>User</th><th>Email</th><th>Role</th><th>Status</th><th>Authenticator</th><th /></tr></thead>
+        <tbody>{(rows || []).map((u) => {
+          const ed = edit?.id === u.id
+          return (<tr key={u.id}>
+            <td>{u.username}{u.must_change_password && <span className="muted"> (must change password)</span>}</td>
+            <td>{ed ? <input className="inline-input" value={edit.email} onChange={(e) => setEdit({ ...edit, email: e.target.value })} /> : u.email || '—'}</td>
+            <td>{ed ? <select value={edit.role} onChange={(e) => setEdit({ ...edit, role: e.target.value })}><option value="analyst">analyst</option><option value="administrator">administrator</option></select> : u.role}</td>
+            <td><Badge level={u.is_active ? 'low' : 'dim'}>{u.is_active ? 'active' : 'disabled'}</Badge></td>
+            <td>{u.authenticator_enrolled ? 'linked' : <span className="muted">not linked</span>}</td>
+            <td><div className="row-actions">
+              {ed ? (<><button className="btn sm" onClick={() => saveEdit(u)}>Save</button><button className="btn sm ghost" onClick={() => setEdit(null)}>Cancel</button></>) : (<>
+                <button className="btn sm ghost" onClick={() => setEdit({ id: u.id, email: u.email || '', role: u.role })}>Edit</button>
+                <button className="btn sm ghost" onClick={() => resetPw(u)}>Reset password…</button>
+                <button className="btn sm ghost" onClick={() => resetMfa(u)}>Reset authenticator…</button>
+                <button className="btn sm danger" onClick={() => toggle(u)}>{u.is_active ? 'Deactivate…' : 'Reactivate…'}</button></>)}
+            </div></td></tr>)
+        })}</tbody></table></div>
+      <form className="panel" onSubmit={create} style={{ marginTop: 16 }}>
+        <h3>Add user</h3>
+        <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
+          <input className="inline-input" placeholder="username" value={nu.username} onChange={(e) => setNu({ ...nu, username: e.target.value })} />
+          <input className="inline-input" placeholder="email" value={nu.email} onChange={(e) => setNu({ ...nu, email: e.target.value })} />
+          <input className="inline-input" type="password" placeholder="initial password (min 8)" value={nu.password} onChange={(e) => setNu({ ...nu, password: e.target.value })} />
+          <select value={nu.role} onChange={(e) => setNu({ ...nu, role: e.target.value })}><option value="analyst">analyst</option><option value="administrator">administrator</option></select>
+          <button className="btn" type="submit">Create</button>
+        </div>
+      </form>
+    </>
+  )
+}
