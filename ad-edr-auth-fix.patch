+# ---- password: change (signed in) and forgot (proved with the authenticator app) ----
+def _set_password(db: Session, user: SystemUser, new_password: str):
+    user.hashed_password = hash_secret(new_password)
+    user.must_change_password = False
+    user.token_version = (user.token_version or 0) + 1  # every older session token stops working
+
+
+@router.post("/password/change")
+def change_password(body: PasswordChange, user=Depends(current_user_any), db: Session = Depends(get_db), ip=Depends(client_ip)):
+    key = f"pwchange:{user.id}"
+    if throttled(key):
+        raise HTTPException(429, "Too many attempts. Try again in 15 minutes")
+    if not verify_secret(body.current_password, user.hashed_password):
+        record_hit(key)
+        audit.log(db, user, "password_change", outcome="denied", details="current password wrong", ip=ip, commit=True)
+        raise HTTPException(400, "Current password is incorrect")
+    if verify_secret(body.new_password, user.hashed_password):
+        raise HTTPException(400, "New password must be different from the current one")
+    clear_hits(key)
+    _set_password(db, user, body.new_password)
+    audit.log(db, user, "password_changed", ip=ip, commit=True)
+    # fresh token so this browser stays signed in while all others are signed out
+    return {"access_token": create_access_token(user.username, user.role.value, user.token_version), "token_type": "bearer", "user": user_out(user)}
+
+
+@router.post("/password/reset")
+def reset_password_self(body: PasswordResetSelf, db: Session = Depends(get_db), ip=Depends(client_ip)):
+    """Forgot-password without e-mail: needs the account's authenticator app. Same generic error for every failure."""
+    key = f"pwreset:{body.username.lower()}:{ip}"
+    generic = HTTPException(400, "Username or code is not valid")
+    if throttled(key):
+        raise HTTPException(429, "Too many attempts. Try again in 15 minutes")
+    user = db.scalar(select(SystemUser).where(SystemUser.username == body.username))
+    step = check_totp(decrypt_secret(user.totp_secret_enc) or "", body.code, user.totp_last_step or 0) if user and user.is_active and user.totp_confirmed else None
+    if step is None:
+        record_hit(key)
+        audit.log(db, user, "password_reset", outcome="denied", details=f"username={body.username}", ip=ip, commit=True)
+        raise generic
+    clear_hits(key)
+    user.totp_last_step = step
+    _set_password(db, user, body.new_password)
+    audit.log(db, user, "password_reset_self", ip=ip, commit=True)
+    return {"reset": True}
 
 
