@@ -20,6 +20,31 @@ def get_db():
         db.close()
 
 
+# Columns added after the first release. create_all() never alters existing tables, so add them in place.
+_USER_COLUMNS = {
+    "totp_secret_enc": ("VARCHAR(512)", None),
+    "totp_confirmed": ("BOOLEAN", "bool0"),
+    "totp_last_step": ("INTEGER", "0"),
+    "must_change_password": ("BOOLEAN", "bool0"),
+    "token_version": ("INTEGER", "0"),
+}
+
+
+def _migrate_users():
+    insp = inspect(engine)
+    if "users" not in insp.get_table_names():
+        return
+    have = {c["name"] for c in insp.get_columns("users")}
+    false = "FALSE" if engine.dialect.name == "postgresql" else "0"
+    with engine.begin() as conn:
+        for name, (ddl, default) in _USER_COLUMNS.items():
+            if name in have:
+                continue
+            default = false if default == "bool0" else default
+            conn.execute(text(f"ALTER TABLE users ADD COLUMN {name} {ddl}" + (f" DEFAULT {default}" if default is not None else "")))
+
+
 def init_db():
     import app.models  # noqa: F401
     Base.metadata.create_all(engine)
+    _migrate_users()
