+
+
+# ---------- authenticator app (TOTP, RFC 6238) ----------
+TOTP_PERIOD = 30
+_fernet = Fernet(base64.urlsafe_b64encode(hashlib.sha256(settings.secret_key.encode()).digest()))
+
+
+def encrypt_secret(plain: str) -> str:
+    return _fernet.encrypt(plain.encode()).decode()
+
+
+def decrypt_secret(token: str | None) -> str | None:
+    if not token:
+        return None
+    try:
+        return _fernet.decrypt(token.encode()).decode()
+    except InvalidToken:
+        return None
+
+
+def seal(text: str) -> str:
+    return _fernet.encrypt(text.encode()).decode()
+
+
+def unseal(token: str, ttl: int) -> str:
+    """Raises cryptography.fernet.InvalidToken if tampered with or older than `ttl` seconds."""
+    return _fernet.decrypt(token.encode(), ttl=ttl).decode()
+
+
+def new_totp_secret() -> str:
+    return pyotp.random_base32()
+
+
+def totp_uri(secret: str, username: str) -> str:
+    return pyotp.TOTP(secret, interval=TOTP_PERIOD).provisioning_uri(name=username, issuer_name=settings.totp_issuer)
+
+
+def check_totp(secret: str, code: str, last_step: int = 0) -> int | None:
+    """Return the matched time step (to be stored as last_step) or None. Accepts +/-1 step of clock drift; a step is single-use."""
+    code = "".join(ch for ch in (code or "") if ch.isdigit())
+    if len(code) != 6:
+        return None
+    totp = pyotp.TOTP(secret, interval=TOTP_PERIOD)
+    now_step = int(time.time() // TOTP_PERIOD)
+    for step in (now_step - 1, now_step, now_step + 1):
+        if step > last_step and secrets.compare_digest(totp.at(step * TOTP_PERIOD), code):
+            return step
+    return None
+
+
+# ---------- tiny in-memory throttle for unauthenticated guessing endpoints ----------
+_hits: dict[str, deque] = defaultdict(deque)
+
+
+def throttled(key: str, limit: int = 5, window: int = 900) -> bool:
+    """True if `key` already used its `limit` attempts within `window` seconds. Call record_hit() on each failure."""
+    q = _hits[key]
+    cutoff = time.time() - window
+    while q and q[0] < cutoff:
+        q.popleft()
+    return len(q) >= limit
+
+
+def record_hit(key: str):
+    _hits[key].append(time.time())
+
+
+def clear_hits(key: str):
+    _hits.pop(key, None)
